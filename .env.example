# ---- Search / discovery (SERVER-SIDE ONLY — never exposed to the browser) ----
# Default provider is Tavily (https://tavily.com — free tier). Set this on your
# Vercel project (Settings → Environment Variables) to promote discovery from
# seeded demo → live. For local live discovery, put it in a local .env (gitignored).
TAVILY_API_KEY=

# Optional: switch providers without touching code (default: tavily).
# SEARCH_PROVIDER=tavily

# NOTE: the LLM gateway URL / key / model are entered in the app's Settings
# panel (client-side, opt-in localStorage) — NOT here.
